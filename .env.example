# ── Database ──────────────────────────────────────────────────────────────
# Per ruling #7 you supply this. Phase 3 runs migrations and the seed against it.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=

# ── Session ───────────────────────────────────────────────────────────────
# Signing secret for the httpOnly session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# ── SMS ───────────────────────────────────────────────────────────────────
# Phase 4 ships a console-logging stub behind an interface, so no live provider
# is needed for the demo. Set to "console" to log instead of sending.
SMS_PROVIDER=console
SMS_SENDER_ID=GREENGO

# ── Device / telemetry tuning ────────────────────────────────────────────
# Seconds without a reading before a device is treated as unknown/stale.
# The handoff's stale copy says "last seen 4 min ago", so the threshold sits
# below that; 120s is two missed 10s cycles plus margin.
DEVICE_STALE_AFTER_SECONDS=120

# Pump interlocks, enforced server-side (Phase 4).
PUMP_MAX_RUN_SECONDS=600
PUMP_COOLDOWN_SECONDS=900
PUMP_DAILY_RUNTIME_CAP_SECONDS=3600

# Commands not collected by the device within this window are discarded,
# never delivered. The device polls every 10s.
COMMAND_TTL_SECONDS=60

# ── Alerting ──────────────────────────────────────────────────────────────
DAILY_SMS_CAP=10
ALERT_COOLDOWN_MINUTES=60
